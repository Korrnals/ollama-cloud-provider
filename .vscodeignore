# .vscodeignore — controls what `vsce package` bundles into the VSIX.
# Ship ONLY runtime files to end users; exclude dev artifacts, tests,
# source, CI, signing material, and dev docs.
# Pre-Marketplace publish finding B1 (code review blocker).

# Test files
test/**
.vscode-test/**

# Source (ship compiled out/ only)
src/**
tsconfig.json
tsconfig.test.json
eslint.config.js

# CI / scripts
scripts/**
.github/**
.cr/

# Build artifacts
out/test/**
dist/
*.vsix
*.tsbuildinfo
# Old release signatures (sha256.txt, .asc, .sigstore.bundle) bloat the
# VSIX (~9KB across v0.9.0–v0.9.3); release artefacts ship via GitHub
# Releases, not inside the extension package.
releases/**

# Dev docs (keep README, CHANGELOG, LICENSE, SECURITY)
DEVELOPMENT.md
HANDOFF.md
CONTRIBUTING.md
docs/**

# GPG / cosign / signing material
# Private signing keys MUST never ship in the VSIX — leaking a private key
# is a credential compromise. cosign.key is the cosign keypair private half;
# *.key is a catch-all for any future key files. cosign.pub is the public
# verification key, distributed via the repo + GitHub Release assets (not VSIX).
cosign.key
cosign.pub
*.key
# Compromised keypair backups (forensic, kept in repo root, NEVER package).
# *.key above does NOT match these — the filename ends in a date suffix
# (-2026-08-04), not .key. Without these patterns the compromised private
# key backup ships inside the VSIX (2026-08-04 incident, second-order leak).
cosign.key.compromised-*
cosign.pub.compromised-*
*.compromised-*
gpg-public-key.asc
*.sig
*.asc
*.pem

# IDE / OS
.vscode/**
.idea/
.DS_Store
Thumbs.db

# Dependencies (already in out/)
node_modules/**

# Dev tooling
Makefile
.nvmrc
.mocharc.json

# VS Code local history (editor artifacts — must never ship)
.history/**

# Misc
.gitignore
.gitattributes