# === Dependencies ===
node_modules/

# === Build output ===
out/
dist/
*.vsix
*.tsbuildinfo

# === Release artifacts (local, never commit) ===
# VSIX files built locally for Marketplace upload + GitHub Release.
# Kept in releases/ for manual re-upload if needed.
releases/*
!releases/.gitkeep

# === IDE / Editor (keep shared configs) ===
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.swp
*.swo
*~

# === OS files ===
.DS_Store
Thumbs.db
desktop.ini
.directory

# === Environment / secrets (NEVER commit) ===
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# === GPG signing keys (local only, NEVER commit) ===
*.gpg
*.asc
secring.gpg
publishing.gpg
!gpg-public-key.asc

# === Logs ===
*.log
logs/

# === Coverage / test output ===
coverage/
.nyc_output/
test-results/
.junit.xml

# === Sigstore / SLSA / SBOM artifacts (generated in CI) ===
# NOTE: cosign.pub is the PUBLIC verification key — it is committed to
# the repo (see SECURITY.md) so downstream consumers can verify sigstore
# bundles without an out-of-band channel. The PRIVATE key (cosign.key)
# stays gitignored via *.key below.
*.sig
*.bundle
*.intoto.json
*.spdx.json
*.spdx.xml

# === Code review (team-local, never commit) ===
.cr/

# === Local development state ===
.ollama-cloud-dev/
local-settings.json
HANDOFF.md

# VS Code local history
.history/
